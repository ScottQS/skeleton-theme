<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__intro">
      <p class="site-footer__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% form 'customer', class: 'site-footer__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
        <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Your email address" autocomplete="email" required>
        <button type="submit" aria-label="Subscribe">→</button>
        {% if form.posted_successfully? %}<p class="site-footer__message">Thank you. A little note is on its way.</p>{% endif %}
        {{ form.errors | default_errors }}
      {% endform %}
      <p class="site-footer__fine-print">{{ section.settings.fine_print }}</p>
    </div>

    <div class="site-footer__nav">
      <div>
        <h3>Explore</h3>
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% else %}
          <a href="#stays">Our rooms</a>
          <a href="#experiences">Experiences</a>
          <a href="#story">The house</a>
          <a href="#journal">Journal</a>
        {% endfor %}
      </div>
      <div>
        <h3>Visit</h3>
        <p>{{ section.settings.address | newline_to_br }}</p>
        <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
      </div>
      <div>
        <h3>Follow</h3>
        {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}">Instagram</a>{% endif %}
        {% if section.settings.pinterest_url != blank %}<a href="{{ section.settings.pinterest_url }}">Pinterest</a>{% endif %}
        <a href="{{ routes.account_url }}">Guest account</a>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}</p>
    <div>
      {% for policy in shop.policies %}
        {% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}
      {% endfor %}
    </div>
    <p>Powered by Shopify</p>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    grid-column: 1 / -1;
    padding: clamp(4rem, 8vw, 7rem) var(--page-margin) 1.5rem;
    background: #102d26;
    color: #f7f2e8;
  }
  .site-footer a { color: inherit; text-decoration: none; }
  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(4rem, 10vw, 10rem);
  }
  .site-footer__eyebrow {
    margin-bottom: 1rem;
    color: #d98b70;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-footer__intro h2 {
    max-width: 12ch;
    font-family: var(--font-display--family);
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .site-footer__form {
    position: relative;
    max-width: 34rem;
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr auto;
    border-bottom: 1px solid rgba(255,255,255,0.55);
  }
  .site-footer__form input {
    min-width: 0;
    padding: 1rem 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #fff;
  }
  .site-footer__form input::placeholder { color: rgba(255,255,255,0.65); }
  .site-footer__form button {
    padding: 0 0 0 1rem;
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 1.5rem;
  }
  .site-footer__message,
  .site-footer__form .errors { grid-column: 1 / -1; margin: 0.6rem 0; font-size: 0.75rem; }
  .site-footer__fine-print { max-width: 33rem; margin-top: 1rem; color: rgba(255,255,255,0.52); font-size: 0.68rem; }
  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .site-footer__nav > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    color: rgba(255,255,255,0.72);
    font-size: 0.8rem;
  }
  .site-footer__nav h3 {
    margin-bottom: 0.9rem;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-footer__nav a:hover { color: #fff; }
  .site-footer__bottom {
    margin-top: clamp(5rem, 10vw, 9rem);
    padding-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    border-top: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.52);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-footer__bottom div { display: flex; gap: 1rem; }
  .site-footer__bottom > p:last-child { text-align: right; }
  @media (max-width: 800px) {
    .site-footer__top { grid-template-columns: 1fr; }
    .site-footer__bottom { grid-template-columns: 1fr; }
    .site-footer__bottom > p:last-child { text-align: left; }
  }
  @media (max-width: 520px) {
    .site-footer__nav { grid-template-columns: 1fr 1fr; }
    .site-footer__bottom div { flex-wrap: wrap; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Letters from Auberge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A slower pace, delivered." },
    { "type": "textarea", "id": "fine_print", "label": "Newsletter note", "default": "Seasonal notes, new rooms, and recipes worth lingering over. Sent occasionally." },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Auberge No. 8" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    { "type": "textarea", "id": "address", "label": "Address", "default": "8 Rua do Sol\nSintra, Portugal" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@aubergeno8.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+351 21 555 0188" },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest" }
  ]
}
{% endschema %}
