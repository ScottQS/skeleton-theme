{% if section.settings.show_announcement %}
  <div class="announcement" role="region" aria-label="Announcement">
    <p>{{ section.settings.announcement_text }}</p>
    {% if section.settings.announcement_link_label != blank %}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_link_label }}</a>
    {% endif %}
  </div>
{% endif %}

<header class="site-header">
  <a class="site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
    {% if section.settings.logo != blank %}
      {{ section.settings.logo | image_url: width: 360 | image_tag: widths: '180, 240, 360', loading: 'eager', alt: shop.name }}
    {% else %}
      <span class="site-header__brand-mark" aria-hidden="true">A</span>
      <span>{{ section.settings.brand_name | default: shop.name }}</span>
    {% endif %}
  </a>

  <nav class="site-header__nav" aria-label="Main navigation">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% else %}
      <a href="#stays">Stays</a>
      <a href="#story">Our story</a>
      <a href="#experiences">Experiences</a>
      <a href="#journal">Journal</a>
    {% endfor %}
  </nav>

  <div class="site-header__actions">
    <a class="site-header__text-link" href="{{ routes.search_url }}">Search</a>
    <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
      <span>Bag</span>
      <span class="site-header__count">{{ cart.item_count }}</span>
    </a>
    <a class="site-header__book" href="{{ section.settings.booking_link }}">
      {{ section.settings.booking_label }}
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <details class="mobile-menu" scroll-lock>
    <summary aria-label="Open navigation">
      <span></span><span></span>
    </summary>
    <nav aria-label="Mobile navigation">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% else %}
        <a href="#stays">Stays</a>
        <a href="#story">Our story</a>
        <a href="#experiences">Experiences</a>
        <a href="#journal">Journal</a>
      {% endfor %}
      <a href="{{ section.settings.booking_link }}">{{ section.settings.booking_label }}</a>
    </nav>
  </details>
</header>

{% stylesheet %}
  .announcement {
    grid-column: 1 / -1;
    min-height: 2.25rem;
    padding: 0.45rem var(--page-margin);
    display: flex;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .announcement a { text-underline-offset: 0.2em; }
  .site-header {
    min-height: 5.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    background: var(--color-background);
  }
  .site-header a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    justify-self: start;
    font-family: var(--font-display--family);
    font-size: 1.45rem;
    letter-spacing: -0.03em;
  }
  .site-header__brand img { width: auto; max-height: 2.75rem; }
  .site-header__brand-mark {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 1rem;
    font-style: italic;
  }
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.2vw, 2.75rem);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-header__nav a { position: relative; }
  .site-header__nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 -0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }
  .site-header__nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .site-header__actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-header__cart { display: flex; align-items: center; gap: 0.4rem; }
  .site-header__count {
    width: 1.25rem;
    height: 1.25rem;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.65rem;
  }
  .site-header__book {
    padding: 0.8rem 1rem;
    background: var(--color-accent);
    color: #fff !important;
  }
  .mobile-menu { display: none; }
  @media (max-width: 900px) {
    .site-header {
      min-height: 4.5rem;
      grid-template-columns: 1fr auto;
    }
    .site-header__nav,
    .site-header__text-link,
    .site-header__book { display: none; }
    .site-header__actions { margin-right: 1rem; }
    .mobile-menu { display: block; }
    .mobile-menu summary {
      width: 2rem;
      height: 2rem;
      display: grid;
      align-content: center;
      gap: 0.4rem;
      list-style: none;
      cursor: pointer;
    }
    .mobile-menu summary::-webkit-details-marker { display: none; }
    .mobile-menu summary span {
      display: block;
      width: 1.6rem;
      height: 1px;
      background: currentColor;
      transition: transform 180ms ease;
    }
    .mobile-menu[open] summary span:first-child { transform: translateY(0.2rem) rotate(45deg); }
    .mobile-menu[open] summary span:last-child { transform: translateY(-0.2rem) rotate(-45deg); }
    .mobile-menu nav {
      position: absolute;
      top: 100%;
      right: calc(var(--page-margin) * -1);
      left: calc((100vw - var(--content-width)) / -2);
      z-index: 20;
      min-height: calc(100svh - 6.75rem);
      padding: 3rem var(--page-margin);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      background: var(--color-background);
      border-top: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    }
    .mobile-menu nav a {
      font-family: var(--font-display--family);
      font-size: clamp(2rem, 10vw, 3.5rem);
      line-height: 1.1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement",
      "default": "Summer tables are open — stay three nights, linger for four"
    },
    {
      "type": "text",
      "id": "announcement_link_label",
      "label": "Announcement link label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Auberge No. 8"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "text",
      "id": "booking_label",
      "label": "Booking label",
      "default": "Book your stay"
    },
    {
      "type": "url",
      "id": "booking_link",
      "label": "Booking link"
    }
  ]
}
{% endschema %}
